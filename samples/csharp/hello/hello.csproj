<Project Sdk="Microsoft.NET.Sdk">
  <!-- A .NET application running Rexx code, with the bridge from nuget.org.
       dotnet run (ooRexx 5 must be installed: rexx on the PATH) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rexx.Net" Version="0.1.0-preview.1" />
  </ItemGroup>
</Project>
