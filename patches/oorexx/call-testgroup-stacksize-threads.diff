   self~assertTrue(n >= 5000, "maximum recursion depth expected to be at least 5000, found" n)
 
+-- deep recursion must end in SYNTAX 11.1 (Control stack full), after a depth
+-- of at least 5000, on the main thread and on any other thread: the stack
+-- limit is computed per thread ([bugs:#2106])
+::method test_stacksize_main_thread
+  -- the test framework runs the tests on the process's main thread
+  self~checkStackFull(stackFull())
 
+::method test_stacksize_started_thread
+  self~checkStackFull(.StackProbe~new~start("STACKFULL")~result)
+
+::method test_stacksize_after_reply
+  probe = .StackProbe~new
+  probe~afterReply      -- returns at once; the recursion goes on in a new thread
+  self~checkStackFull(probe~result)   -- RESULT is guarded: it waits for AFTERREPLY
+
+::method checkStackFull private
+  parse arg code n
+  self~assertSame("11.1", code)
+  self~assertTrue(n >= 5000, "maximum recursion depth expected to be at least 5000, found" n)
+
