+-- for the test_stacksize_* tests: recurse until the control stack is full;
+-- returns the condition's code and the depth reached
+::routine stackFull
+  depth = .directory~new
+  signal on syntax
+  call stackRecurse depth, 1
+  return "no error" depth~n
+syntax:
+  return condition("O")~code depth~n
+
+::routine stackRecurse
+  use arg depth, n
+  depth~n = n
+  call stackRecurse depth, n + 1
+
+::class StackProbe
+::method stackFull
+  return stackFull()
+::method afterReply
+  expose result
+  reply
+  result = stackFull()
+::method result
+  expose result
+  return result
